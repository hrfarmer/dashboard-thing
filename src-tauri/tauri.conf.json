{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TXST Lab Dashboard",
  "version": "0.1.0",
  "identifier": "edu.txst.spacelab.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TXST Lab Dashboard",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
